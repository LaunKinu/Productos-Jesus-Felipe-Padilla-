@page
@using Front_Producto_JP_Lib.Pages.Ventanas
@model ProductosModel
@{
    ViewData["Title"] = "Productos";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Productos</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flNombre" 
                placeholder="Nombre"
                asp-for="@Model.Filtro!.Nombre"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Productos</h3>

                <label>
                    Codigo
                </label>
                <input id=nmCodigo"
                    asp-for="@Model.Actual!.Codigo"/>
                <br />

                <label>
                    Nombre
                </label>
                <input id=nmNombre"
                    asp-for="@Model.Actual!.Nombre"/>
                <br />

                <label>
                    Cantidad
                </label>
                <input id=nmCantidad"
                    asp-for="@Model.Actual!.Cantidad"/>
                <br />

                <label>
                    Precio
                </label>
                <input id=nmPrecio"
                       asp-for="@Model.Actual!.Precio" />
                <br />

                <label>
                    Fecha De Comprar
                </label>
                <input id=nmFecha_Compra"
                       asp-for="@Model.Actual!.Fecha_Compra" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la asignacion con información 
                            @Model.Actual!.Codigo,
                            @Model.Actual!.Nombre,
                            @Model.Actual!.Cantidad,
                            @Model.Actual!.Precio,
                            @Model.Actual!.Fecha_Compra?
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Fecha_Compra</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Codigo</td>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Cantidad</td>>
                                <td>@elemento.Precio</td>
                                <td>@elemento.Fecha_Compra</td>>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>